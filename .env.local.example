# Copy to .env.local for local development with `docker compose`.
# Never commit the real file — see .gitignore.

# Postgres connection string used by the app container. `db` is the
# compose service name; it resolves on the compose network only.
DATABASE_URL=postgresql://postgres:postgres@db:5432/aitj

# Auth.js v5
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# First-boot admin account (see prisma/seed.ts / AITJ-M0-07). Password must
# be at least 10 characters.
SEED_ADMIN_EMAIL=admin@aitj.local
SEED_ADMIN_PASSWORD=change-this-password

NODE_ENV=development
TZ=Asia/Kolkata
